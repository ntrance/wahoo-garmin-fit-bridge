# App
TZ=Europe/London
WEB_PORT=8088
APP_NAME=wahoo-garmin-fit-bridge
POLL_SECONDS=60
MAX_RETRIES=3
LOG_LEVEL=INFO

# Optional basic auth for web UI
WEB_AUTH_ENABLED=true
WEB_USERNAME=admin
WEB_PASSWORD=change-this-password
WEB_PASSWORD_HASH=
SESSION_SECRET_KEY=change-this-long-random-secret
SESSION_COOKIE_NAME=wahoo_bridge_session
SESSION_COOKIE_SECURE=false
SESSION_MAX_AGE_SECONDS=43200
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# rclone
RCLONE_REMOTE=dropbox
DROPBOX_WAHOO_PATH=Apps/WahooFitness
RCLONE_POLL_SECONDS=300
RCLONE_CONFIG_PATH=/appdata/rclone/rclone.conf

# Paths inside containers
FIT_INCOMING_DIR=/data/incoming
FIT_PROCESSING_DIR=/data/processing
FIT_UPLOADED_DIR=/data/uploaded
FIT_DUPLICATE_DIR=/data/duplicate
FIT_FAILED_DIR=/data/failed
FIT_ARCHIVE_DIR=/data/archive
SQLITE_PATH=/appdata/bridge.sqlite
LOG_DIR=/appdata/logs
RUNTIME_CONFIG_PATH=/appdata/runtime.env
REAL_FIT_DIR=/real_fit
REAL_FIT_UPLOAD_DIR=/appdata/real_fit
MAX_REAL_FIT_UPLOAD_BYTES=33554432
DETECTED_DEVICES_PATH=/appdata/detected_devices.json

# Garmin upload
GARMIN_CONFIG_DIR=/appdata/garmin
GARMIN_PROFILE_NAME=wahoo
GARMIN_DEVICE_NAME=Garmin Device
GARMIN_UNIT_ID=
DRY_RUN=true
